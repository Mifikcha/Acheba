filters:
  and:
    - type == "curriculum_topic"
    - subject == "physics"
    - student_visible == true
    - file.inFolder("Репетиторство/Шизончик/Теория")
    - or:
        - section == "mechanics"
        - and:
            - section == "molecular_physics"
            - topic_id != "PHYS-MKT-003"
        - and:
            - section == "electrodynamics"
            - topic_id != "PHYS-EM-006"
            - topic_id != "PHYS-EM-007"
            - topic_id != "PHYS-EM-008"
            - topic_id != "PHYS-EM-009"
        - topic_id == "PHYS-QUANT-003"
        - topic_id == "PHYS-REF-001"
properties:
  file.name:
    displayName: Заметка
  topic_id:
    displayName: Код
  section:
    displayName: Раздел
  title:
    displayName: Тема
  order:
    displayName: Порядок
  status:
    displayName: Статус
  materials_ready:
    displayName: Материалы
views:
  - type: table
    name: Физика 9 класс
    groupBy:
      property: section
      direction: ASC
    order:
      - file.name
      - topic_id
      - section
      - title
      - order
      - status
      - materials_ready
    sort:
      - property: file.name
        direction: DESC
      - property: topic_id
        direction: DESC
