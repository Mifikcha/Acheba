filters:
  and:
    - type == "curriculum_topic"
    - subject == "physics"
    - student_visible == true
    - file.inFolder("репетиторство/шизончик/теория")
properties:
  file.name:
    displayName: Заметка
  topic_id:
    displayName: Код
  section:
    displayName: Раздел
  title:
    displayName: Тема
  order:
    displayName: Порядок
  status:
    displayName: Статус
  materials_ready:
    displayName: Материалы
views:
  - type: table
    name: Физика 11 класс
    groupBy:
      property: section
      direction: ASC
    order:
      - file.name
      - topic_id
      - section
      - title
      - order
      - status
      - materials_ready
